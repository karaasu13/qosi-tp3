#!/bin/sh
# VNF 2 — Classifier: fronteira de confiança. Substitui o DSCP que vem dos hosts
# por uma marcação baseada em IP, porta e protocolo (tc flower + pedit).
#
#   descendente (eth0 -> eth1), pelo servidor de origem:
#     VoIP   UDP de 10.1.1.10:2112         -> EF   (46)
#     Vídeo  TCP de 10.1.2.10:5201         -> AF41 (34)
#     Web    TCP de 10.1.3.10:80           -> BE   (0)
#     Bulk   TCP de 10.1.3.10:5202-5204    -> LE   (1)
#     resto  qualquer IPv4                 -> BE   (0)  (apaga marcações dos hosts)
#   ascendente (eth1 -> eth0):
#     VoIP   UDP para 10.1.1.10:2112       -> EF
#     resto                                -> BE
set -e
. /usr/local/bin/vnf-comum.sh
VOIP=${VOIP:-10.1.1.10} VIDEO=${VIDEO:-10.1.2.10} WEB=${WEB:-10.1.3.10}

limpar
base
encaminhar_tc

# descendente
remarcar eth0 10 $TOS_EF   eth1 ip_proto udp src_ip "$VOIP"  src_port 2112
remarcar eth0 11 $TOS_AF41 eth1 ip_proto tcp src_ip "$VIDEO" src_port 5201
remarcar eth0 12 $TOS_BE   eth1 ip_proto tcp src_ip "$WEB"   src_port 80
remarcar eth0 13 $TOS_LE   eth1 ip_proto tcp src_ip "$WEB"   src_port 5202-5204
remarcar eth0 90 $TOS_BE   eth1
# ascendente
remarcar eth1 10 $TOS_EF   eth0 ip_proto udp dst_ip "$VOIP"  dst_port 2112
remarcar eth1 90 $TOS_BE   eth0
echo "vnf-classifier: remarcação DSCP ativa"
